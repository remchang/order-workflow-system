# ---- Python ----
.venv/
__pycache__/
*.pyc
.pytest_cache/
pip*.txt

# ---- Node ----
node_modules/
npm-debug.log*

# ---- Node-RED 运行目录与上下文 ----
# data/ 里是运行态（SQLite 库、Node-RED 的 userDir、文件 Context 落盘文件）。
# 注意必须写成 data/* 再单独放行 README.md ——
# 写成 data/ 的话 Git 根本不会进这个目录，"!" 例外也不会生效
# （这是个很经典的 .gitignore 坑）。
data/*
!data/README.md

# ---- 数据库与运行产物 ----
# SQLite 库里有测试过程中扣掉的库存，是运行态不是源码。
# 重建方式：scripts/zhongzhi.ps1
*.db
*.db-wal
*.db-shm
service/data/

# ---- 日志 ----
*.log

# ---- 凭据 ----
.env
*.pem
*.key
